{
  "description": "Meldet dem SUMAX Büro Start, Lebenszeichen und Ende der Claude-Code-Sitzung (nur Sitzungs-ID, Zustand, Repo-Name).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/melden.py\" start",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/melden.py\" heartbeat",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/melden.py\" end",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
